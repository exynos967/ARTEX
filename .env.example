# Docker 部署配置（复制为 .env）
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# 镜像仓库与版本（自建仓库可设置 ARTEX_IMAGE=registry.example.com/project/artex）
ARTEX_IMAGE=ghcr.io/exynos967/artex
ARTEX_TAG=latest

# 可选动态 Runner 池（--profile runners），硬并发上限见 deploy/runner/compose.json。
# Docker daemon 所在宿主机的绝对目录；每套部署须使用独立目录/网络。
ARTEX_RUNNER_DATA_DIR=/var/lib/artex-runner
ARTEX_RUNNER_NETWORK=artex-runners
ARTEX_RUNNER_SERVER_URL=http://artex:8787
ARTEX_RUNNER_TOKEN_FILE=./deploy/private/runner.enrollment

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# 可选透明 SOCKS5 出口网关（配合 -f deploy/egress-proxy/docker-compose.socks5.yml 使用，说明见 deploy/egress-proxy/README.md）
# 支持 socks5:// 与 socks5h://，密码含特殊字符请 URL 编码；宿主机代理请用 host.docker.internal（勿填 127.0.0.1）
# 示例：EGRESS_SOCKS5_URL=socks5://user:pass@203.0.113.10:1080  或  socks5://host.docker.internal:1080
EGRESS_SOCKS5_URL=
# 主服务与 Runner 使用不同出口时可分别覆盖（留空则共用 EGRESS_SOCKS5_URL）
# ARTEX_EGRESS_SOCKS5_URL=
# RUNNER_EGRESS_SOCKS5_URL=
# 外网 DNS 上游（固定经 TCP over SOCKS5，仅填 IP 或 IP:port）
EGRESS_DNS_SERVER=1.1.1.1
# 可选直连域名后缀 / 私网网段（逗号分隔）；如仅主服务 LLM 直连可改配 ARTEX_EGRESS_BYPASS_DOMAINS=api.openai.com,api.anthropic.com
EGRESS_BYPASS_DOMAINS=
EGRESS_BYPASS_CIDRS=
# Fail-closed 防泄漏 Kill Switch（默认 1）、非 DNS UDP 转发（默认 0 拒绝防泄漏）、劫持工具直连 53 端口 DNS（默认 1）
EGRESS_KILL_SWITCH=1
EGRESS_SOCKS5_UDP=0
EGRESS_HIJACK_TUN_DNS=1
# Runner 网关固定容器名（同宿主机部署多套 ARTEX 时须区分）
ARTEX_RUNNER_EGRESS_CONTAINER=artex-runner-egress-gw
# 可选网关镜像与构建源覆盖
# EGRESS_SING_BOX_IMAGE=ghcr.io/sagernet/sing-box:v1.14.4
# EGRESS_ALPINE_MIRROR=mirrors.tuna.tsinghua.edu.cn
# EGRESS_LOG_LEVEL=info

# 可选私有 OOB 带外验证（Interactsh；填完后主服务与动态 Runner 内的 nuclei 自动注入 -iserver/-itoken，默认留空不启用）
# ARTEX_OOB_SERVER=https://oob.example.com
# ARTEX_OOB_TOKEN=
ARTEX_OOB_SERVER=
ARTEX_OOB_TOKEN=
# 未配私有 OOB 时设为 1 可禁止 nuclei 回退访问公共 oast.*（默认 0）
ARTEX_OOB_DISABLE_PUBLIC=0

# 可选 SSH 反向隧道反连中转（配合 -f deploy/callback-relay/docker-compose.ssh.yml 使用，说明见 deploy/callback-relay/README.md）
# 私钥仅挂入独立无特权 Sidecar，主服务与 Runner 无法接触私钥；边缘机只需 sshd 开启 GatewayPorts clientspecified
# 示例：CALLBACK_SSH_HOST=203.0.113.20
CALLBACK_SSH_HOST=
CALLBACK_SSH_PORT=22
CALLBACK_SSH_USER=artex-relay
CALLBACK_SSH_KEY_FILE=./deploy/private/callback_id_ed25519
# 推荐：填入 ssh-keyscan 输出以严格锁定边缘机指纹（留空则首次 accept-new）
CALLBACK_SSH_KNOWN_HOSTS=
CALLBACK_BIND_ADDRESS=0.0.0.0
# 边缘机对外地址及映射给主服务 artex 的反连端口（支持 20001-20005、逗号分隔或 8080:18080 异端口映射）
ARTEX_CALLBACK_PUBLIC_HOST=
ARTEX_CALLBACK_PORTS=20001-20005
# 可选：同时配合 --profile runner-callback 把独立端口段反连至 Runner 网关（须与主服务端口错开，留空不启用）
# ARTEX_RUNNER_CALLBACK_PUBLIC_HOST=
# ARTEX_RUNNER_CALLBACK_PORTS=20011-20015

# 可选工具安全限额：
#   NORMA_GREP_TIMEOUT_MS  - Grep / Glob 单次执行毫秒上限（默认 30000 即 30 秒）
#   NORMA_BASH_MAX_FILE_MB - Agent Bash 子命令与动态 Runner 单文件大小上限 MiB（默认 2048 即 2 GiB，0 表示不限；不影响归档包与附件上传）
# NORMA_GREP_TIMEOUT_MS=30000
# NORMA_BASH_MAX_FILE_MB=2048
