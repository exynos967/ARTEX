# 透明 SOCKS5 出口网关配置（按需追加到根目录 .env，或通过 --env-file 传入）
#
# 必填：上游 SOCKS5 出口地址（支持 socks5:// 与 socks5h://，支持可选用户名密码，密码含特殊字符请 URL 编码）
# 若代理跑在 Docker 宿主机上，请勿写 127.0.0.1，改用 host.docker.internal（并让代理监听宿主机网桥或 0.0.0.0）
EGRESS_SOCKS5_URL=socks5://user:pass@203.0.113.10:1080

# 可选：主服务 artex 与 Runner 使用不同出口节点时可分别覆盖（留空则共用 EGRESS_SOCKS5_URL）
# ARTEX_EGRESS_SOCKS5_URL=
# RUNNER_EGRESS_SOCKS5_URL=

# 可选：外网 DNS 上游（固定走 TCP over SOCKS5，默认 1.1.1.1，仅填 IP 或 IP:port）
EGRESS_DNS_SERVER=1.1.1.1

# 可选：不走 SOCKS5 而直连的域名后缀（逗号分隔），例如仅让 LLM API 直连而目标扫描流量全走代理：
# EGRESS_BYPASS_DOMAINS=api.openai.com,api.anthropic.com
# 如需只让主服务直连 LLM、Runner 依然全走代理，请改配 ARTEX_EGRESS_BYPASS_DOMAINS：
# ARTEX_EGRESS_BYPASS_DOMAINS=api.openai.com,api.anthropic.com
EGRESS_BYPASS_DOMAINS=

# 可选：不走 SOCKS5 而直连的私网/目标网段（逗号分隔 CIDR）
EGRESS_BYPASS_CIDRS=

# Fail-closed 防泄漏开关（默认 1）：开启 iptables OUTPUT Kill Switch，网关异常或工具绕过时直接拒绝外联
EGRESS_KILL_SWITCH=1

# 是否通过 SOCKS5 UDP Associate 转发非 DNS 的 UDP 流量（默认 0：拒绝非 DNS UDP，避免不支持 UDP 的代理卡死及 WebRTC/QUIC 泄漏）
EGRESS_SOCKS5_UDP=0

# 是否劫持工具直连外部 53 端口的 DNS 请求（默认 1，确保 subfinder/dnsx/nuclei 等自带解析器也经 TCP over SOCKS5，无 DNS 泄漏）
EGRESS_HIJACK_TUN_DNS=1

# 可选：Runner 网关固定容器名（同一宿主机部署多套 ARTEX 时须区分）
ARTEX_RUNNER_EGRESS_CONTAINER=artex-runner-egress-gw

# 可选：镜像与构建源覆盖
# EGRESS_SING_BOX_IMAGE=ghcr.io/sagernet/sing-box:v1.14.4
# EGRESS_ALPINE_MIRROR=mirrors.tuna.tsinghua.edu.cn
# EGRESS_LOG_LEVEL=info
